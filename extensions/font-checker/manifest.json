{
  "manifest_version": 3,
  "name": "Font Substring Checker",
  "version": "1.1.0",
  "description": "Find and highlight elements whose computed font family contains a saved substring.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Font checker settings",
    "default_popup": "popup.html"
  },
  "devtools_page": "devtools.html"
}
