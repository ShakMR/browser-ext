{
  "manifest_version": 3,
  "name": "AWS Account Selector",
  "version": "1.0.2",
  "description": "A Chrome extension to select AWS accounts.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://signin.aws.amazon.com/saml"
      ],
      "js": [
        "./content.js"
      ]
    }
  ]
}
